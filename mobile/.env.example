# Copy to .env and fill in. .env is git-ignored.
# Only EXPO_PUBLIC_ values reach the app, and users can see them: no secrets here.
EXPO_PUBLIC_API_URL=
# Supabase: Project Settings → API Keys. Use the PUBLISHABLE key (sb_publishable_...),
# never the secret key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
